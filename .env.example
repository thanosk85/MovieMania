# Copy this file to .env and fill in your own values. Never commit .env.

# Used by the app (bundled into the client; safe to expose)
# Supabase dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-anon-or-publishable-key

# Used only by scripts/sync-movies.mjs (never prefix these with EXPO_PUBLIC_)
# SECRET: bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# TMDB > Settings > API > API Key (v3)
TMDB_API_KEY=your-tmdb-v3-api-key
